# Trading 212 API Key (Trading 212 app > Settings > API)
T212_API_KEY=your_trading212_api_key_here

# Use 'live' or 'demo' (STRONGLY recommend demo first)
T212_MODE=demo

# Anthropic API Key (console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Position sizing ────────────────────────────────────────────────────────────
# Max % of total portfolio value per position
MAX_POSITION_PCT=5.0
# Max % of portfolio in one sector (prevents over-concentration)
MAX_SECTOR_PCT=35.0
# Max number of open positions at once
MAX_OPEN_POSITIONS=10

# ── Analysis ──────────────────────────────────────────────────────────────────
# How often the AI runs a full scan (minutes)
ANALYSIS_INTERVAL_MINUTES=30
# Minimum AI confidence to execute a trade (0-100)
MIN_CONFIDENCE=70

# ── Risk management ────────────────────────────────────────────────────────────
# Fixed stop-loss: sell if position drops this % from entry
STOP_LOSS_PCT=3.0
# Fixed take-profit: sell if position gains this %
TAKE_PROFIT_PCT=8.0
# Trailing stop: follows price upward, sells if price falls this % from peak
TRAILING_STOP_PCT=2.0
# Auto-pause bot if portfolio drops this % in one day
DAILY_LOSS_LIMIT_PCT=5.0

# ── Bot behaviour ──────────────────────────────────────────────────────────────
# Only place orders during US market hours (9:30–16:00 ET Mon–Fri)
TRADE_MARKET_HOURS_ONLY=true
# Dollar-cost averaging: buy dips on watchlist tickers
DCA_MODE=false
# DCA trigger: buy when price is this % below SMA200 and RSI < 45
DCA_DROP_TRIGGER_PCT=3.0

# Server port
PORT=8000
