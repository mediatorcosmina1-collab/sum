# Trading 212 API Key (get from: Trading 212 app > Settings > API)
T212_API_KEY=your_trading212_api_key_here

# Use 'live' or 'demo' (STRONGLY recommend demo first)
T212_MODE=demo

# Anthropic API Key (get from: console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Max % of portfolio to risk per trade (default 5%)
MAX_POSITION_PCT=5.0

# How often the AI runs analysis (minutes)
ANALYSIS_INTERVAL_MINUTES=30

# Max open positions at one time
MAX_OPEN_POSITIONS=10

# Stop loss % per trade
STOP_LOSS_PCT=3.0

# Take profit % per trade
TAKE_PROFIT_PCT=8.0

# Minimum confidence score for AI to execute a trade (0-100)
MIN_CONFIDENCE=70

# Server port
PORT=8000
